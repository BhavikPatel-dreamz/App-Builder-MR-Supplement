{
  "name": "App Builder MR-Supplement",
  "private": true,
  "scripts": {
    "build": "bash -c 'if [ \"${VERCEL:-}\" = \"1\" ] || [ \"${GITHUB_ACTIONS:-}\" = \"true\" ]; then bash .githooks/pre-commit --ci; fi' && prisma generate && prisma migrate deploy && react-router build",
    "security:scan": "bash .githooks/pre-commit --ci",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && bash .githooks/pre-commit --install || true",
    "dev": "shopify app dev --tunnel-url=https://bhavik.dynamicdreamz.net:3000",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node --import dotenv/config ./node_modules/@react-router/serve/bin.js ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy && npm run ota:migrate",
    "ota:migrate": "hot-updater db migrate ./app/lib/ota/hotUpdaterInstance.server.ts --yes",
    "ota:import": "node ./scripts/ota-import.mjs",
    "postinstall": "prisma generate",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "build:ci": "prisma generate && react-router build",
    "test": "vitest run",
    "test:watch": "vitest",
    "register:queries": "tsx scripts/register-persisted-queries.ts",
    "load-test:coalescing": "tsx scripts/load-test-coalescing.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@hot-updater/core": "0.35.8",
    "@hot-updater/plugin-core": "0.35.8",
    "@hot-updater/server": "0.35.8",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-router/dev": "^7.18.0",
    "@react-router/fs-routes": "^7.18.0",
    "@react-router/node": "^7.18.0",
    "@react-router/serve": "^7.18.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "dotenv": "^16.4.7",
    "gutenberg-block-kit": "^1.1.6",
    "isbot": "^5.1.31",
    "kysely": "^0.28.2",
    "pg": "^8.13.1",
    "prisma": "7.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4",
    "ioredis": "^6.0.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/app-bridge-types": "^0.7.1",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "hot-updater": "0.35.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^4.1.11",
    "tsx": "^4.20.3"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "@hot-updater/plugin-core": {
      "mime": "3.0.0"
    }
  },
  "author": "ubuntu",
  "packageManager": "pnpm@12.3.1+sha512.3c14c15408d1489d350f8ed7f93361d26cc707054f6849a4eea3bb7407ff4fe4564b413a1c421a773a176ab1168a8df1c7d548f2cd0dc7d344f58c4e680a5b18"
}
