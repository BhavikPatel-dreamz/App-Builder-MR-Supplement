NODE_ENV=production
PORT=3000
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_mobile_platform_applications,write_mobile_platform_applications,write_metaobject_definitions,write_metaobjects,write_products,read_files,write_files
SHOPIFY_APP_URL=https://ab.mrsupplement.com.au
# Caddy TLS host(s). Comma-separated if serving more than one, e.g.
# APP_DOMAINS=ab.mrsupplement.com.au,mrsupplement.dreamzapps.com
APP_DOMAINS=ab.mrsupplement.com.au
APP_DOMAIN=ab.mrsupplement.com.au
DATABASE_URL=postgresql://appbuilder:CHANGE_ME@127.0.0.1:5432/appbuilder
REDIS_URL=redis://127.0.0.1:6379
SHOPIFY_STOREFRONT_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
CRON_SECRET=
